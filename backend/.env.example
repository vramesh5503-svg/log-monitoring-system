# ─────────────────────────────────────────────────────────────────
# Log Security Monitoring System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Application
APP_NAME="Log Security Monitoring System"
APP_VERSION="1.0.0"
DEBUG=True

# Database  (SQLite default; switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./logs_security.db
# For Render PostgreSQL (auto-provided when you attach a database, postgres:// is automatically normalized to postgresql://):
# DATABASE_URL=postgresql://user:password@hostname/dbname

# JWT — generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — for deployed Vercel frontend, set to: https://<your-project>.vercel.app (supports comma-separated origins)
FRONTEND_URL=http://localhost:5173

# Default admin credentials (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@logsecurity.com

# Email alerts (optional SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Alert thresholds
ALERT_THRESHOLD=5
BRUTE_FORCE_WINDOW=300

# File upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
